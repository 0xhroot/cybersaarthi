<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug builds talk to LAN dev servers over cleartext HTTP
         (e.g. http://192.168.x.x:8000 from a paired QR / LAN discovery).
         Release keeps the secure base config (cleartext rejected). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>