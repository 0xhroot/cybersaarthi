# CyberSaarthi - local demonstration configuration
# Copy to `.env` and adjust if needed:  cp .env.example .env
#
# These values are DEV-ONLY demo defaults. NEVER create `.env` from this for any
# real or internet-facing deployment, and NEVER commit the actual `.env` file.
# Change every password/secret before any non-local use.

# --- Application ---
APP_NAME=cybersaarthi
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cybersaarthi
POSTGRES_USER=cybersaarthi
POSTGRES_PASSWORD=cybersaarthi

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cybersaarthi

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=cybersaarthi
S3_SECRET_KEY=cybersaarthi
S3_BUCKET=cybersaarthi
S3_REGION=us-east-1

# --- Security ---
# Development-only secret. Replace with a strong random value for any other use
# (e.g. `openssl rand -hex 32`).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=dev-secret-change-me

# --- Local AI assistant (llama.cpp + Qwen3-8B, optional) ---
# The assistant degrades gracefully: with AI_ENABLED=false (or no model file)
# every /ai/* endpoint answers 503 AI_DISABLED / AI_UNAVAILABLE and the rest of
# the platform is unaffected. See docs/ai/LOCAL_MODEL_SETUP.md.
AI_ENABLED=true
# Host-side only: absolute, or relative to the repo root. docker-compose.yml
# pins the container's AI_MODEL_PATH to /models/Qwen3-8B-Q4_K_M.gguf (where
# the compose mount places the file) — this value must not be container-ized.
AI_MODEL_PATH=Qwen3-8B-Q4_K_M.gguf
# llama-server binary (install with scripts/ai/setup_runtime.sh).
AI_SERVER_BINARY=ai_runtime/llama.cpp/llama-server
# The server runs as a HOST process (the backend container has no GPU). It binds
# 0.0.0.0 so the container can reach it; AI_SERVER_API_KEY is then MANDATORY and
# the socket bridge (scripts/ai/socket_bridge.sh) exposes it to the container
# over a Unix domain socket, so no TCP path crosses the host firewall.
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8081
# Generate with: openssl rand -hex 32   (never commit the real .env)
AI_SERVER_API_KEY=
# UDS path used inside the backend container (set by docker-compose.yml).
AI_SERVER_SOCKET=
# false in docker-compose (the host runs the server); true for bare-metal runs.
AI_MANAGE_SERVER=false
AI_CONTEXT_LENGTH=8192
AI_MAX_OUTPUT_TOKENS=512
# -1 offloads every layer to the GPU.
AI_GPU_LAYERS=-1
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_CONCURRENT_GENERATIONS=2
# Chat requests per minute per user (0 disables the limiter).
AI_PER_USER_RATE_LIMIT=20
AI_MAX_HISTORY_MESSAGES=12
AI_TOOL_MAX_ITERATIONS=3
AI_CONVERSATION_RETENTION_DAYS=90
AI_KNOWLEDGE_ENABLED=true
AI_FEATURE_CASE=true
AI_FEATURE_EVIDENCE=true
AI_FEATURE_GRAPH=true
AI_FEATURE_COPILOT=true
AI_FEATURE_REPORT_DRAFT=true
# Keep false: prompt/answer content must never reach application logs.
AI_LOG_PROMPTS=false