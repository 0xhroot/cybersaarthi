# CyberSaarthi - local development environment
# Copy to `.env` and adjust values if needed:  cp .env.example .env
#
# These values are development-only. NEVER commit the real `.env` file.

# --- Application ---
APP_NAME=cybersaarthi
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cybersaarthi
POSTGRES_USER=cybersaarthi
POSTGRES_PASSWORD=cybersaarthi

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cybersaarthi

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=cybersaarthi
S3_SECRET_KEY=cybersaarthi
S3_BUCKET=cybersaarthi
S3_REGION=us-east-1

# --- Security ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=dev-secret-change-me