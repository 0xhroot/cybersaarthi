    {
      "path": "sih_demo_seed/persons.csv",
      "format": "csv",
      "case": "graph",
      "purpose": "140 synthetic persons with phone, vehicle, organization and account for the graph demonstration.",
      "coverage": ["entity_resolution", "graph", "relationship_discovery"],
      "required_columns": ["name", "phone", "vehicle_no", "organization", "account_no", "city"],
      "checks": ["required_fields", "entity_relationships", "fixture_isolation"],
      "expected": { "rows": 140, "phone_pattern": "^\\+91-9000\\d{6}$", "name_words": 2, "organizations": 12 }
    },
    {
      "path": "sih_demo_seed/transfers.json",
      "format": "json",
      "case": "graph",
      "purpose": "Network of dated money transfers driving graph flow analytics.",
      "coverage": ["financial_flow", "graph"],
