        "placeholders": ["{{CASE_NUMBER}}", "{{EV_STATEMENT}}", "{{EV_LEDGER}}", "{{EV_URLS}}", "{{EV_TIMELINE}}", "{{EV_MISSING}}"]
      }
    },
    {
      "path": "showcase_fixtures/supporting_payments.csv",
      "format": "csv",
      "case": "support",
      "purpose": "Two payments for the supporting case; PAYOUT-A shares beneficiary account and phone with the primary case (cross-case candidate), PAYOUT-B shares only the merchant name.",
      "coverage": ["cross_case"],
      "required_columns": ["reference", "date", "amount", "currency", "account_number", "beneficiary_phone", "name", "note"],
      "checks": ["required_fields", "date_consistency", "entity_relationships"],
      "expected": {
        "rows": 2,
        "shared_with_primary": { "reference": "PAYOUT-A", "phone": "+91 98200 00001", "account_hint": "ACC-SIH-001" }
