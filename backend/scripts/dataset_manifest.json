    {
      "path": "sih_demo_seed/associations.txt",
      "format": "txt",
      "case": "graph",
      "purpose": "140 lines: 40 person-association sentences (names must resolve to persons.csv) and 100 call-detail-record lines (device numbers must resolve to persons.csv phones).",
      "coverage": ["relationship_discovery", "entity_resolution"],
