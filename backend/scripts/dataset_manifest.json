{
  "schema": "cybersaarthi.dataset/v1",
  "updated": "2026-11-10",
  "description": "Machine-readable manifest for the synthetic SIH showcase dataset. Every fixture shipped in backend/scripts/showcase_fixtures/ and backend/scripts/sih_demo_seed/, its purpose, the capabilities it feeds, and the static expectations validate_showcase_dataset.py asserts. All data is fictional; runtime counts are checked separately by `make demo-status` (see docs/demo/SIH_SHOWCASE.md section 14).",
  "validator": "python -m scripts.validate_showcase_dataset (static, stdlib-only)",
  "cases": [
    {
      "key": "primary",
      "case_number": "SIH-2026-001",
      "title": "SIH Showcase - Sunrise Mercantile payment-diversion fraud",
      "role": "showcase",
      "synthetic": true
    },
    {
      "key": "support",
      "case_number": "SIH-2026-002",
      "title": "DEMO FIXTURE - related merchant payment inquiries",
      "role": "demo fixture",
      "synthetic": true
    }
  ],
  "fixtures": [
    {
      "path": "showcase_fixtures/complaint_mixed.txt",
      "format": "txt",
      "case": "primary",
      "purpose": "Bilingual (English + Devanagari) complaint establishing the incident, the disputed transaction and the victim.",
      "coverage": ["multilingual", "extraction", "entity_resolution"],
      "checks": ["synthetic_marker", "complaint_reference", "devanagari_present", "iso_dates"],
      "expected": { "complaint_ref": "CMP-SIH-2026-0417", "languages": ["en", "hi"] }
    },
    {
      "path": "showcase_fixtures/merchant_statement.csv",
      "format": "csv",
      "case": "primary",
      "purpose": "Bank statement of seven debits; source of truth for financial arithmetic and the contradiction pair.",
      "coverage": ["financial_flow", "contradiction_detection", "report_audit"],
      "required_columns": ["transaction_id", "date", "amount", "currency", "status", "account_number", "beneficiary_name", "bank_name"],
      "checks": ["required_fields", "date_consistency", "transaction_arithmetic"],
      "expected": {
        "rows": 7,
        "dated_completed_rows": 6,
        "dated_completed_total": "125700.00",
        "all_rows_total": "126699.00",
        "designed_gaps": [
          "TXN-SIH-1006 has empty currency",
          "TXN-SIH-1007 has empty date"
        ]
      }
    },
    {
      "path": "showcase_fixtures/wallet_ledger.json",
      "format": "json",
      "case": "primary",
      "purpose": "Merchant wallet settlement ledger; disagrees with the statement on TXN-SIH-1001 by design.",
      "coverage": ["financial_flow", "contradiction_detection", "report_audit"],
      "item_keys": ["transaction_id", "date", "amount", "status", "currency", "account", "beneficiary_name"],
      "checks": ["required_fields", "expected_contradiction"],
      "expected": {
        "rows": 2,
        "designed_contradiction": {
          "transaction_id": "TXN-SIH-1001",
          "statement_amount": "47500.00",
          "ledger_amount": "45000.00",
          "delta": "2500.00"
        }
      }
    },
    {
      "path": "showcase_fixtures/entity_review.csv",
      "format": "csv",
      "case": "primary",
      "purpose": "Five entity rows containing two deliberate alias pairs for the human resolution queue.",
      "coverage": ["entity_resolution"],
      "required_columns": ["name", "organization", "phone", "account_number", "incident_date"],
      "checks": ["required_fields", "date_consistency", "entity_relationships"],
      "expected": {
        "rows": 5,
        "pending_resolution_pairs": 2,
        "alias_pairs": [
          ["Ravi Kulkarni", "R. Kulkarni"],
          ["Suresh Pawar", "S. Pawar"]
        ]
      }
    },
    {
      "path": "showcase_fixtures/phishing_urls.txt",
      "format": "txt",
      "case": "primary",
      "purpose": "Inert lure URLs for forensics triage; the triage engine must classify them and never fetch them.",
      "coverage": ["forensic_triage"],
      "checks": ["synthetic_marker", "inert_urls"],
      "expected": { "urls": 4 }
