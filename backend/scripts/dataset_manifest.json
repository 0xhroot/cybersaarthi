      "checks": ["required_fields", "source_references"],
      "expected": { "rows": 3, "filenames": ["statement_export.csv", "wallet_export.csv", "lure_capture.txt"] }
    },
    {
      "path": "showcase_fixtures/report_draft.tpl.md",
      "format": "md",
      "case": "primary",
      "purpose": "Deliberately imperfect report draft template with designed defects for the AI report auditor.",
      "coverage": ["report_audit"],
      "checks": ["report_audit_findings", "source_references"],
      "expected": {
        "designed_defects": [
