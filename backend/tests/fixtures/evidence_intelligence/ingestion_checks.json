        "text": "Invoice for Asha Verma of Sunrise Traders account ACC-7781 amount 1,200.50 INR on 2026-01-15. Payment received in full"
      },
      "raw": "{\"person_names\": [\"Asha Verma\"], \"organization_names\": [\"Sunrise Traders\"], \"phone_numbers\": [], \"email_addresses\": [], \"account_references\": [\"ACC-7781\"], \"transaction_amounts\": [\"1,200.50 INR\"], \"transaction_dates\": [\"2026-01-15\"], \"urls\": [], \"domains\": [], \"device_identifiers\": [], \"statements\": [\"Payment received in full\"], \"events\": []}",
      "expect": {"status": "valid", "unverified_fields": [], "issue_codes": []}
    },
